{
  "name": "dbt DuckDB & uv Environment",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "innoverio.vscode-dbt-power-user",
        "chuckjonas.duckdb"
      ]
    }
  },

  "postCreateCommand": "uv sync"
}
