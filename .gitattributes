# Force GitHub to detect ALL .sql files anywhere in the repo hierarchy
*.sql linguist-language=SQL
*.sql linguist-detectable=true
**/*.sql linguist-detectable=true
data_modeling/**/*.sql linguist-detectable=true

# Ignore generated dbt artifacts, packages, and raw data from byte counts
target/** linguist-vendored
dbt_packages/** linguist-vendored
*.csv linguist-vendored
*.json linguist-vendored
*.parquet linguist-vendored
