# PYTHON 
*.py linguist-language=Python
*.py linguist-detectable=true
**/*.py linguist-language=Python
**/*.py linguist-detectable=true
data_storytelling/**/*.py linguist-language=Python
data_storytelling/**/*.py linguist-detectable=true

# DOCKER & DEVCONTAINER
.devcontainer/Dockerfile linguist-language=Dockerfile
.devcontainer/Dockerfile linguist-detectable=true
.devcontainer/Dockerfile linguist-vendored=false
.devcontainer/Dockerfile linguist-documentation=false

Dockerfile linguist-language=Dockerfile
Dockerfile linguist-detectable=true

# SQL MODELS GENERATED ARTIFACTS
*.sql linguist-language=SQL
*.sql linguist-detectable=true
data_modeling/**/*.sql linguist-language=SQL
data_modeling/**/*.sql linguist-detectable=true

data_modeling/target/** linguist-vendored
data_modeling/dbt_packages/** linguist-vendored
data_modeling/logs/** linguist-vendored
**/target/** linguist-vendored
**/dbt_packages/** linguist-vendored

# DATA, BINARY, AND DOCUMENTATION 
*.csv linguist-vendored
*.json linguist-vendored
*.parquet linguist-vendored
*.duckdb linguist-vendored
*.duckdb.wal linguist-vendored
*.md linguist-documentation
